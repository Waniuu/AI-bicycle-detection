+      <img id="videoFeed" src="/video" alt="Camera feed" onerror="this.style.background='#000'">
+      <div class="badge" id="fpsBadge">-- FPS</div>
+    </div>
+
+    <div class="stats-panel">
+      <div class="stats-grid">
+        <div class="stat-card bike">
+          <div class="label">Bicycles Today</div>
+          <div class="value" id="bikeTodayVal">0</div>
+          <div class="sub">Total: <span id="bikeAllTimeVal">0</span></div>
+        </div>
+
+        <div class="stat-card scooter">
+          <div class="label">Scooters Today</div>
+          <div class="value" id="scooterTodayVal">0</div>
+          <div class="sub">Total: <span id="scooterAllTimeVal">0</span></div>
+        </div>
+
+        <div class="stat-card fps">
+          <div class="label">Pipeline FPS</div>
+          <div class="value" id="fpsVal">0</div>
+          <div class="sub">Processing speed</div>
+        </div>
+
+        <div class="stat-card active">
+          <div class="label">Active Tracks</div>
+          <div class="value" id="activeVal">0</div>
+          <div class="sub">Objects in view</div>
+        </div>
+      </div>
+
+      <div class="card" style="margin-top: 12px; padding: 14px; background: #161b22; border: 1px solid #30363d; border-radius: 8px;">
+        <h3 style="margin-top: 0; font-size: 0.8rem; color: #8b949e;">⚙️ Live Counting Settings</h3>
+        <form id="liveConfigForm" style="margin-top: 10px;">
+          <div style="margin-bottom: 10px;">
+            <label for="input_line_y" style="display: block; font-size: 0.7rem; color: #8b949e; margin-bottom: 3px;">Line Y Position (px):</label>
+            <input type="number" id="input_line_y" placeholder="e.g. 240" style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #30363d; background: #0d1117; color: white; font-size: 0.8rem;">
+          </div>
+          <div style="margin-bottom: 10px;">
+            <label for="input_min_conf" style="display: block; font-size: 0.7rem; color: #8b949e; margin-bottom: 3px;">AI Min Confidence (0.1 - 1.0):</label>
+            <input type="number" step="0.05" min="0.1" max="1.0" id="input_min_conf" placeholder="e.g. 0.45" style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #30363d; background: #0d1117; color: white; font-size: 0.8rem;">
+          </div>
+          <button type="submit" style="width: 100%; padding: 8px; background: #238636; color: white; border: none; border-radius: 4px; font-weight: 600; font-size: 0.75rem; cursor: pointer;">
+            Save Settings
+          </button>
+        </form>
+      </div>
+    </div>
+  </div>
+
+  <!-- SEKCJA LOGÓW SYSTEMOWYCH NA ŻYWO (TERMINAL) -->
+  <div class="logs-panel">
+    <h3>💻 Live System Logs</h3>
+    <div class="console-box" id="consoleBox">
+      <div class="log-line"><span class="log-time">[SYSTEM]</span> Initializing Live Console stream...</div>
+    </div>
