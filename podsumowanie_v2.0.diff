+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
+<title>Urban Mobility Dashboard (Bikes & Scooters)</title>
+<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
+<style>
+*{margin:0;padding:0;box-sizing:border-box}
+body{font-family:'Segoe UI',system-ui,sans-serif;background:#0f1117;color:#e0e0e0;min-height:100vh;-webkit-text-size-adjust:100%}
+header{background:#161b22;border-bottom:1px solid #30363d;padding:10px 16px;display:flex;align-items:center;gap:10px}
+header h1{font-size:1rem;color:#58a6ff;white-space:nowrap}
+header .dot{width:10px;height:10px;border-radius:50%;background:#f85149;flex-shrink:0}
+header .dot.ok{background:#3fb950}
+header .meta{margin-left:auto;font-size:0.7rem;color:#8b949e;white-space:nowrap}
+header .db-btn{background:#21262d;border:1px solid #30363d;color:#58a6ff;padding:4px 12px;border-radius:6px;font-size:0.75rem;cursor:pointer;text-decoration:none;white-space:nowrap}
+header .db-btn:hover{background:#161b22;border-color:#58a6ff}
+
+.container{padding:8px;max-width:100%}
+.video-panel{background:#000;border-radius:8px;overflow:hidden;position:relative;margin-bottom:8px}
+.video-panel img{width:100%;height:auto;display:block;object-fit:contain;background:#000}
+.video-panel .badge{position:absolute;top:8px;right:8px;background:rgba(0,0,0,0.75);padding:3px 8px;border-radius:4px;font-size:0.7rem;color:#3fb950;font-weight:600}
+
+/* Kafelki mobilne */
+.big-count-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
+.big-count{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px;text-align:center}
+.big-count .num{font-size:2.5rem;font-weight:800;line-height:1}
+.big-count.bike .num{color:#58a6ff}
+.big-count.scooter .num{color:#238636}
+.big-count .lbl{font-size:0.65rem;color:#8b949e;margin-top:4px;text-transform:uppercase;letter-spacing:1px}
+
+/* Grid ze statystykami */
+.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px}
+.stat-card{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px}
+.stat-card .label{font-size:0.65rem;color:#8b949e;text-transform:uppercase;letter-spacing:0.5px}
+.stat-card .value{font-size:1.5rem;font-weight:700;margin-top:2px}
+.stat-card .sub{font-size:0.7rem;color:#6e7681;margin-top:1px}
+
+.stat-card.bike .value{color:#58a6ff}
+.stat-card.scooter .value{color:#238636}
+.stat-card.fps .value{color:#3fb950}
+.stat-card.active .value{color:#d2a8ff}
+
+/* STYL DLA SYSTEM LOGS (TERMINAL) */
+.logs-panel{background:#0d1117;border:1px solid #30363d;border-radius:8px;padding:12px;margin-bottom:16px}
+.logs-panel h3{font-size:0.8rem;color:#8b949e;margin-bottom:8px;display:flex;align-items:center;gap:6px}
+.console-box{background:#040d12;border:1px solid #21262d;border-radius:6px;padding:10px;font-family:'Consolas','Courier New',monospace;font-size:0.75rem;color:#3fb950;height:120px;overflow-y:auto;white-space:pre-wrap;line-height:1.4}
+.console-box .log-line{margin-bottom:2px}
+.console-box .log-time{color:#8b949e;margin-right:6px}
+.console-box .log-info{color:#58a6ff}
+.console-box .log-detect{color:#3fb950;font-weight:600}
+.console-box .log-warn{color:#d29922}
+
+.charts-row{display:grid;grid-template-columns:1fr;gap:8px;margin-bottom:8px}
+.chart-card{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px}
+.chart-card h3{font-size:0.75rem;color:#8b949e;margin-bottom:8px}
+
+.events-panel{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px}
+.events-panel h3{font-size:0.75rem;color:#8b949e;margin-bottom:8px}
+
+table{width:100%;border-collapse:collapse;font-size:0.8rem}
+th{text-align:left;padding:6px 8px;border-bottom:1px solid #30363d;color:#8b949e;font-size:0.7rem}
+td{padding:6px 8px;border-bottom:1px solid #21262d}
+.no-data{color:#484f58;font-style:italic;text-align:center;padding:20px}
+
+.badge-type{display:inline-block;padding:2px 6px;border-radius:4px;font-size:0.7rem;font-weight:600;text-transform:capitalize}
+.badge-type.bicycle{background:rgba(88,166,255,0.15);color:#58a6ff;border:1px solid rgba(88,166,255,0.3)}
+.badge-type.e-scooter{background:rgba(35,134,54,0.15);color:#3fb950;border:1px solid rgba(35,134,54,0.3)}
+
+@media(min-width:768px){
+  .container{max-width:1400px;margin:0 auto;padding:16px}
+  .top-row{display:grid;grid-template-columns:1fr 320px;gap:16px;margin-bottom:16px}
+  .video-panel{margin-bottom:0}
+  .big-count-grid{display:none}
+  .stats-grid{grid-template-columns:1fr 1fr;gap:10px;margin-bottom:0}
+  .charts-row{grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
+  .stat-card .value{font-size:1.8rem}
+}
+</style>
+</head>
+<body>
+
+<header>
+  <div class="dot" id="statusDot"></div>
+  <h1>Mobility Counter</h1>
+  <a href="/database" class="db-btn">Database</a>
+  <span class="meta" id="versionTag" style="color:#58a6ff;margin-left:4px">v{{ version }}</span>
